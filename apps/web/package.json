{
  "name": "@ideamory/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:capacitor": "node -e \"const {execSync}=require('node:child_process'),fs=require('node:fs');execSync('npx next build',{stdio:'inherit',env:{...process.env,CAPACITOR_EXPORT:'true'}});fs.rmSync('.next-export/downloads',{recursive:true,force:true});\"",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@ideamory/api-spec": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.475.0",
    "match-sorter": "^8.0.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.2",
    "react-textarea-autosize": "^8.5.9",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
